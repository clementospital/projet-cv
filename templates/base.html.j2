<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <script>
    // Applique le thème stocké avant le premier rendu, pour éviter un flash sombre/clair.
    (function () {
      if (localStorage.getItem("theme") === "light") {
        document.documentElement.dataset.theme = "light";
      }
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ identite.titre }} — {{ accroche | truncate(150) }}">
  <meta name="theme-color" content="#0a0e0c">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%230a0e0c'/%3E%3Ctext x='50' y='68' font-size='54' font-family='monospace' font-weight='bold' fill='%2339ff88' text-anchor='middle'%3E%3E_%3C/text%3E%3C/svg%3E">
  <title>{% block titre %}{{ identite.nom }}{% endblock %} — {{ identite.nom }}</title>
  <link rel="stylesheet" href="{{ base }}style.css">
</head>
<body>
  <a class="skip-link" href="#contenu">Aller au contenu</a>

  <header class="site-header">
    <div class="site-header-inner">
      <a href="{{ base }}index.html" class="brand">~/clement-ospital $</a>

      <nav class="nav" id="nav">
        {% for p in pages %}
        <a href="{{ base }}{{ p.fichier }}" class="nav-link{% if p.id == page_actuelle %} nav-link-actif{% endif %}">{{ p.libelle }}</a>
        {% endfor %}
        <a href="{{ base }}cv.pdf" download class="nav-link nav-link-pdf">Télécharger le CV</a>
      </nav>

      <div class="header-actions">
        <a class="btn btn-ghost" href="{{ base }}cv.pdf" download>Télécharger le CV</a>
        <button type="button" class="icon-btn" id="theme-toggle" aria-label="Changer de thème" aria-pressed="false">🌙</button>
        <button type="button" class="nav-toggle" id="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <main id="contenu">
    {% block contenu %}{% endblock %}
  </main>

  <footer class="site-footer">
    <div class="site-footer-inner">
      <p class="footer-contact">
        <button type="button" class="copy-email" id="copy-email" data-email="{{ identite.email }}">{{ identite.email }}</button>
        {% if identite.telephone %}<span>· {{ identite.telephone }}</span>{% endif %}
        {% if identite.localisation %}<span>· {{ identite.localisation }}</span>{% endif %}
      </p>
      {% if identite.github %}
      <p class="footer-links"><a href="{{ identite.github }}">{{ identite.github }}</a></p>
      {% endif %}
      <p class="footer-copy">$ echo "© {{ annee }} {{ identite.nom }}"</p>
    </div>
  </footer>

  <button type="button" class="back-to-top" id="back-to-top" aria-label="Remonter en haut de la page">↑</button>

  <script src="{{ base }}script.js" defer></script>
</body>
</html>
